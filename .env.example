# Copy to .env and edit. app/config.py loads .env through python-dotenv.
# Every variable is optional and the values below are the defaults from app/config.py.

# PostgreSQL connection string. Alembic migrations read the same variable.
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/appdb

# Redis cache for trending results. With caching off the engine keeps counts in memory only.
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0
TRENDING_TTL_SECONDS=60

# Retries for report and trending database queries, with exponential backoff in seconds.
DB_RETRY_ATTEMPTS=3
DB_RETRY_MIN_WAIT=1
DB_RETRY_MAX_WAIT=10

# Logging. LOG_FORMAT is json (one object per line) or text.
LOG_LEVEL=INFO
LOG_FORMAT=json
